<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Propuesta.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Propuesta.Views"
    Title="Propuesta">

    <FlyoutItem Title="Inicio" Icon="home.png">
        <ShellContent
            Title="Dashboard"
            ContentTemplate="{DataTemplate views:DashboardView}"
            Route="DashboardView" />
    </FlyoutItem>

    <FlyoutItem Title="Equipos" Icon="team.png">
        <ShellContent
            Title="Equipos"
            ContentTemplate="{DataTemplate views:TeamsView}"
            Route="TeamsView" />
    </FlyoutItem>

    <FlyoutItem Title="Partidos" Icon="match.png">
        <ShellContent
            Title="Partidos"
            ContentTemplate="{DataTemplate views:MatchesView}"
            Route="MatchesView" />
    </FlyoutItem>

    <FlyoutItem Title="Posiciones" Icon="standings.png">
        <ShellContent
            Title="Posiciones"
            ContentTemplate="{DataTemplate views:StandingsView}"
            Route="StandingsView" />
    </FlyoutItem>

</Shell>
