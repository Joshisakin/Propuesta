<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Propuesta.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Propuesta.Views"
    Title="Propuesta">

    <FlyoutItem Title="Inicio" Icon="home.png">
        <ShellContent
            Title="Dashboard"
            ContentTemplate="{DataTemplate views:PaginaPrincipal}"
            Route="PaginaPrincipal" />
    </FlyoutItem>

    <FlyoutItem Title="Equipos" Icon="team.png">
        <ShellContent
            Title="Equipos"
            ContentTemplate="{DataTemplate views:PaginaEquipos}"
            Route="PaginaEquipos" />
    </FlyoutItem>

    <FlyoutItem Title="Partidos" Icon="match.png">
        <ShellContent
            Title="Partidos"
            ContentTemplate="{DataTemplate views:PaginaPartidos}"
            Route="PaginaPartidos" />
    </FlyoutItem>

    <FlyoutItem Title="Posiciones" Icon="standings.png">
        <ShellContent
            Title="Posiciones"
            ContentTemplate="{DataTemplate views:PaginaClasificacion}"
            Route="PaginaClasificacion" />
    </FlyoutItem>

</Shell>
