<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Propuesta.Models"
             xmlns:viewmodels="clr-namespace:Propuesta.ViewModels"
             x:Class="Propuesta.Views.TeamsView"
             Title="Equipos">
    <ContentPage.BindingContext>
        <viewmodels:TeamsViewModel/>
    </ContentPage.BindingContext>
    <Grid RowDefinitions="*,Auto">
        <CollectionView ItemsSource="{Binding Teams}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Team">
                    <Frame Padding="10" Margin="10" CornerRadius="10" BorderColor="{StaticResource Gray200}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Image Source="{Binding LogoUrl}" WidthRequest="50" HeightRequest="50" Aspect="AspectFit" Margin="0,0,10,0"/>
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="Medium"/>
                                <Label Text="{Binding Description}" FontSize="Small"/>
                            </VerticalStackLayout>
                            <Button Grid.Column="2" Text="Ver" Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:TeamsViewModel}}, Path=ViewTeamCommand}" CommandParameter="{Binding .}"/>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="1" Text="Registrar Nuevo Equipo" Command="{Binding AddTeamCommand}" Margin="10"/>
    </Grid>
</ContentPage>