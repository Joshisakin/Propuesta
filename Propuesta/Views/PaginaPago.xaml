<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Propuesta.Views.PaginaPago"
             Title="Registro de Pago">
    <ScrollView>
        <VerticalStackLayout Padding="20">
            <Label Text="Registrar Pago"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   Margin="0,0,0,20" />
            <Label Text="Monto de Inscripción" />
            <Entry Text="{Binding Amount}" Keyboard="Numeric" />

            <Label Text="Método de Pago" />
            <Picker Title="Seleccione un método" ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding SelectedPaymentMethod}" />

            <Button Text="Procesar Pago" Command="{Binding ProcessPaymentCommand}" HorizontalOptions="Center" Margin="0,30,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>