<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Propuesta.Models"
             x:Class="Propuesta.Views.PaginaPartidos"
             Title="Partidos">
    <VerticalStackLayout Padding="20">
        <Label Text="Próximos Partidos"
               FontSize="28"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               Margin="0,0,0,20" />

        <CollectionView ItemsSource="{Binding Partidos}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Match">
                    <Frame Padding="10" Margin="5" CornerRadius="5" BorderColor="LightGray">
                        <VerticalStackLayout>
                            <Label Text="{Binding HomeTeam.Name} vs {Binding AwayTeam.Name}" FontAttributes="Bold" FontSize="Medium"/>
                            <Label Text="{Binding MatchDateTime, StringFormat='{0:dd/MM/yyyy HH:mm}'}" FontSize="Small" TextColor="Gray"/>
                            <HorizontalStackLayout HorizontalOptions="End">
                                <Label Text="{Binding HomeScore}"/>
                                <Label Text=" - "/>
                                <Label Text="{Binding AwayScore}"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>