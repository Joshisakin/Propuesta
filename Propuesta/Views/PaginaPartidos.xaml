<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Propuesta.Models"
             xmlns:viewmodels="clr-namespace:Propuesta.ViewModels"
             x:Class="Propuesta.Views.MatchesView"
             Title="Partidos">
    <ContentPage.BindingContext>
        <viewmodels:MatchesViewModel/>
    </ContentPage.BindingContext>
    <Grid RowDefinitions="Auto, *">
        <Label Grid.Row="0" Text="Próximos Partidos" Style="{StaticResource TitleLarge}" Padding="10"/>
        <CollectionView Grid.Row="1" ItemsSource="{Binding Matches}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Match">
                    <Frame Padding="10" Margin="10" CornerRadius="10" BorderColor="{StaticResource Gray200}">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="{Binding MatchDateTime, StringFormat='{0:dd/MM/yyyy HH:mm}'}" HorizontalOptions="Center" FontSize="Small" TextColor="{StaticResource Gray500}"/>
                            <Grid ColumnDefinitions="*, Auto, *" ColumnSpacing="10">
                                <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center">
                                    <Image Source="{Binding HomeTeam.LogoUrl}" HeightRequest="40" Aspect="AspectFit"/>
                                    <Label Text="{Binding HomeTeam.Name}" HorizontalOptions="Center" FontAttributes="Bold"/>
                                </VerticalStackLayout>

                                <Label Grid.Column="1" Text="{Binding HomeScore, StringFormat='{0}'}" FontSize="Large" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="-" FontSize="Large" VerticalOptions="Center" Margin="15,0,0,0"/>
                                <Label Grid.Column="1" Text="{Binding AwayScore, StringFormat='{0}'}" FontSize="Large" VerticalOptions="Center" Margin="30,0,0,0"/>

                                <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center">
                                    <Image Source="{Binding AwayTeam.LogoUrl}" HeightRequest="40" Aspect="AspectFit"/>
                                    <Label Text="{Binding AwayTeam.Name}" HorizontalOptions="Center" FontAttributes="Bold"/>
                                </VerticalStackLayout>
                            </Grid>
                            <Button Text="Registrar Resultado" Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MatchesViewModel}}, Path=RecordResultCommand}" CommandParameter="{Binding .}" IsVisible="{Binding IsResultConfirmed, Converter={StaticResource InverseBoolConverter}}"/>
                            <Label Text="Resultado Confirmado" IsVisible="{Binding IsResultConfirmed}" HorizontalOptions="Center" TextColor="Green" FontAttributes="Bold"/>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>